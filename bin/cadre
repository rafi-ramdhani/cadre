#!/usr/bin/env bash
# cadre: start, stop and list persona sessions. Each persona is a Claude Code
# session in its own tmux window, so an orchestrator session can message it
# by name.
#
#   cadre init <name> [parent dir]            generate a new cadre from the template
#   cadre use <dir>                           make an existing cadre the active one
#   cadre add project <name> <owner/repo> [team] [about] [--no-trust]
#   cadre add team <team> | cadre add persona <team>/<role>
#   cadre up <team|team/role> [project|dir]   start a team or one persona
#   cadre down <team|team/role> [project]     stop a team or one persona
#   cadre down --all [--yes]                  stop every cadre session (asks first)
#   cadre attach <team> [project]             open a team's tmux session
#   cadre ls                                  list teams, roles and what runs
#   cadre projects                            list the project registry
#   cadre path <project>                      print a project's local folder
#   cadre sync [--no-trust]                   clone missing registry projects
#   cadre trust <project> | --all             trust registry project folders in Claude Code
#   cadre update [--check]                    update the framework (fast-forward only)
#   cadre version                             print the version
#   cadre uninstall [--yes | --dry-run]       remove the command, skill, hook and
#                                             config (keeps your cadre and projects)
#
# Registered projects are trusted in Claude Code when added or cloned, so
# personas start there without the trust prompt; --no-trust skips that.
#
# A team started for a project gets its own sessions: `cadre up dev my-app`
# names them dev-my-app-<role> in tmux session cadre-dev-my-app. Without a
# project they are <team>-<role> in tmux session cadre-<team>.

set -euo pipefail

CADRE_VERSION=0.1.1

die() { echo "cadre: $*" >&2; exit 1; }
expand() { case $1 in "~"*) echo "$HOME${1#\~}" ;; *) echo "$1" ;; esac; }

# CADRE_TMUX_SOCKET runs every session on a separate tmux server (tests use it).
# Targets use tmux's exact match (=name, =session:=window): a plain -t falls
# back to a prefix match, so cadre-dev would hit cadre-dev-app.
tmux() { command tmux ${CADRE_TMUX_SOCKET:+-L "$CADRE_TMUX_SOCKET"} "$@"; }

resolve() {
  local p=$1 t
  while [ -L "$p" ]; do
    t=$(readlink "$p")
    case $t in /*) p=$t ;; *) p=$(dirname "$p")/$t ;; esac
  done
  echo "$p"
}
CADRE_ROOT=$(cd "$(dirname "$(resolve "${BASH_SOURCE[0]}")")/.." && pwd)

CONFIG="$HOME/.config/cadre/home"
# Hashes of persona settings files as cadre last wrote them, one per line.
PSET_HASHES="$HOME/.config/cadre/persona-settings.sha256"

# The active cadre: $CADRE_HOME, else the one recorded by init or use.
load_home() {
  if [ -z "${CADRE_HOME:-}" ] && [ -f "$CONFIG" ]; then
    CADRE_HOME=$(expand "$(head -1 "$CONFIG")")
  fi
  if [ -z "${CADRE_HOME:-}" ] || [ ! -d "$CADRE_HOME" ]; then
    die "no active cadre; run cadre init <name> or cadre use <dir>"
  fi
  # cadre.conf may set PERMISSION_MODE.
  PERMISSION_MODE=default
  # shellcheck source=/dev/null
  if [ -f "$CADRE_HOME/cadre.conf" ]; then . "$CADRE_HOME/cadre.conf"; fi
  MODE=${CADRE_PERMISSION_MODE:-$PERMISSION_MODE}
  PERSONAS="$CADRE_HOME/personas"
  REGISTRY="$CADRE_HOME/projects.yaml"
  PSET="$CADRE_HOME/.claude/persona-settings.json"
  # Generated persona prompts and settings copies. They live under .claude/,
  # which Claude Code protects: no allow rule pre-approves writes there.
  BUILD="$CADRE_HOME/.claude/build"
}

set_home() { mkdir -p "$(dirname "$CONFIG")"; echo "$1" > "$CONFIG"; }

# A project's folder: its `path` (relative paths are inside the cadre),
# else projects/<name>.
project_dir() {
  local p; p=$(reg "$1" path)
  [ -n "$p" ] || p="projects/$1"
  case $p in /*) echo "$p" ;; "~"*) expand "$p" ;; *) echo "$CADRE_HOME/$p" ;; esac
}

# Registry lookups. projects.yaml is a flat list of entries, each a name
# line followed by indented "key: value" lines.
reg() {
  python3 - "$REGISTRY" "$@" <<'PY'
import os, sys
path, args = sys.argv[1], sys.argv[2:]
entries, cur = {}, None
if os.path.exists(path):
    for line in open(path):
        s = line.rstrip("\n")
        if not s.strip() or s.lstrip().startswith("#"):
            continue
        if not s[0].isspace() and s.rstrip().endswith(":"):
            cur = s.strip()[:-1]
            entries[cur] = {}
        elif cur and ":" in s:
            k, v = s.strip().split(":", 1)
            entries[cur][k.strip()] = v.strip()
if args[0] == "names":
    print("\n".join(entries))
elif args[0] == "table":
    for n, e in entries.items():
        print("\t".join([n, e.get("team", ""), e.get("about", "")]))
elif args[0] == "has":
    print("yes" if args[1] in entries else "")
else:
    print(entries.get(args[0], {}).get(args[1], ""))
PY
}

# Running cadre sessions, one per line: the tmux session, a tab, and the
# personas in it (its windows are named by role).
running_sessions() {
  local s
  for s in $(tmux ls -F '#S' 2>/dev/null | grep '^cadre-' || true); do
    printf '%s\t%s\n' "$s" "$(tmux list-windows -t "=$s" -F "${s#cadre-}-#W" 2>/dev/null | paste -sd ' ' -)"
  done
}

# Prints running_sessions output for a person to read.
show_sessions() {
  local s personas
  [ -n "$1" ] || return 0
  while IFS=$'\t' read -r s personas; do echo "  $s: $personas"; done <<<"$1"
}

# The cadre session this command runs in, if any: $TMUX names a session on
# the same tmux server.
own_session() {
  [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || return 0
  [ "${TMUX%%,*}" = "$(tmux display -p -t "$TMUX_PANE" '#{socket_path}' 2>/dev/null)" ] || return 0
  tmux display -p -t "$TMUX_PANE" '#S' 2>/dev/null | grep '^cadre-' || true
}

# Stops the given tmux sessions and prints one line each. The session this
# command runs in is left for stop_own_session, so the caller can print its
# summary first. Sets OWN_SESSION and STOP_FAILED (names that would not stop).
stop_sessions() {
  local s
  OWN_SESSION=$(own_session) STOP_FAILED=""
  for s in "$@"; do
    [ "$s" != "$OWN_SESSION" ] || continue
    if tmux kill-session -t "=$s" 2>/dev/null; then echo "  $s stopped"; else STOP_FAILED+=" $s"; echo "  $s could not be stopped"; fi
  done
  case " $* " in *" $OWN_SESSION "*) ;; *) OWN_SESSION="" ;; esac
}

stop_own_session() {
  [ -n "$OWN_SESSION" ] || return 0
  echo "  stopping $OWN_SESSION last (this command runs in it)"
  tmux kill-session -t "=$OWN_SESSION" 2>/dev/null || true
}

# Stops the given sessions except the one this command runs in, runs
# <then> (the rest of the caller's work and its closing message), and stops
# that own session last. Returns 2 when a session would not stop, else the
# status of <then>.
stop_all() {
  local then=$1 rc=0; shift
  stop_sessions "$@"
  if [ -n "$STOP_FAILED" ]; then echo "cadre: could not stop:$STOP_FAILED" >&2; fi
  "$then" || rc=$?
  stop_own_session
  if [ -n "$STOP_FAILED" ]; then return 2; fi
  return "$rc"
}

# Asks "<question> [y/N]" on a terminal. Succeeds with --yes ($2 set) or a
# yes answer; without a terminal it says how to confirm and fails.
confirm() {
  local reply=""
  [ -z "${2:-}" ] || return 0
  if [ ! -t 0 ]; then echo "run with --yes to confirm" >&2; return 1; fi
  read -r -p "$1 [y/N] " reply || true
  case $reply in y|Y|yes|YES|Yes) return 0 ;; *) echo "nothing changed"; return 1 ;; esac
}

# Quotes $1 for any shell tmux may run (POSIX sh, bash, zsh, fish): single
# quotes, with each ' written as '\''.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# The folder for generated prompts and settings copies, ignored by the
# cadre's git through its own .gitignore.
ensure_build() {
  mkdir -p "$BUILD"
  if [ ! -f "$BUILD/.gitignore" ]; then printf '*\n' > "$BUILD/.gitignore"; fi
}

roles_of() { find "$PERSONAS/$1" -maxdepth 1 -name '*.md' -exec basename {} .md \; | sort; }
key_of() { if [ -n "${2:-}" ]; then echo "$1-$2"; else echo "$1"; fi; }
window_exists() { tmux list-windows -t "=cadre-$1" -F '#W' 2>/dev/null | grep -qx "$2"; }

# A team's .workdir file wins; otherwise the team gets a folder in the setup.
default_dir() {
  local wd="$PERSONAS/$1/.workdir"
  if [ -f "$wd" ]; then expand "$(head -1 "$wd")"; else echo "$CADRE_HOME/teams/$1"; fi
}

start_role() {
  local key=$1 team=$2 role=$3 dir=$4 explicit=$5
  local name="$key-$role" prompt="$BUILD/$key-$role.md"
  [ -f "$PERSONAS/$team/$role.md" ] || die "no persona $team/$role"
  if window_exists "$key" "$role"; then echo "  $name already running"; return; fi

  # A <role>.workdir file pins one persona to its own folder, unless a
  # project or dir was given.
  local wd="$PERSONAS/$team/$role.workdir"
  if [ -z "$explicit" ] && [ -f "$wd" ]; then dir=$(expand "$(head -1 "$wd")"); fi

  mkdir -p "$dir"
  ensure_build
  # Rebuilt and swapped in whole at every start, whatever is there now.
  {
    cat "$CADRE_ROOT/protocol.md"
    if [ -f "$CADRE_HOME/protocol.md" ]; then echo; cat "$CADRE_HOME/protocol.md"; fi
    echo
    cat "$PERSONAS/$team/$role.md"
  } > "$prompt.tmp.$$"
  mv -f "$prompt.tmp.$$" "$prompt"

  # Every value is single-quoted: tmux hands the command to the user's shell
  # (bash, zsh, sh, fish), and a path may hold a quote or a space.
  local cmd
  cmd="CADRE_PERSONA=$(sq "$name") claude --name $(sq "$name") --permission-mode $(sq "$MODE") --append-system-prompt-file $(sq "$prompt")"
  if [ -n "${PSET_ARG:-}" ]; then cmd+=" --settings $(sq "$PSET_ARG")"; fi
  if tmux has-session -t "=cadre-$key" 2>/dev/null; then
    tmux new-window -d -t "=cadre-$key:" -n "$role" -c "$dir" "$cmd"
  else
    tmux new-session -d -s "cadre-$key" -n "$role" -c "$dir" "$cmd"
  fi
  # A command that cannot run ends at once: its window closes, or stays with
  # a dead pane when the user's tmux sets remain-on-exit.
  sleep 0.5
  if ! window_exists "$key" "$role" \
    || [ "$(tmux list-panes -t "=cadre-$key:=$role" -F '#{pane_dead}' 2>/dev/null | head -1)" = 1 ]; then
    echo "  $name failed to start: its command exited at once; run it by hand in $dir to see why:" >&2
    echo "    $cmd" >&2
    return 1
  fi
  echo "  $name started in $dir"
}

# Turns a project name or a folder into "project dir".
locate() {
  local arg=$1 path
  if [ -n "$(reg has "$arg")" ]; then
    path=$(project_dir "$arg")
    [ -d "$path" ] || die "project '$arg' is not at $path (run cadre sync)"
    echo "$arg $path"
  elif [ -d "$arg" ]; then
    path=$(cd "$arg" && pwd)
    echo "$(basename "$path" | tr -c 'a-zA-Z0-9\n' '-') $path"
  else
    die "'$arg' is neither a registry project nor a folder"
  fi
}

split_target() {
  TEAM=${1%%/*} ROLE=""
  [ "$TEAM" != "$1" ] && ROLE=${1#*/}
  [ -d "$PERSONAS/$TEAM" ] || die "no team '$TEAM' (see cadre ls)"
}

cmd_up() {
  [ -n "${1:-}" ] || die "usage: cadre up <team|team/role> [project|dir]"
  split_target "$1"
  local proj="" dir="" explicit=""
  if [ -n "${2:-}" ]; then read -r proj dir <<<"$(locate "$2")"; explicit=$dir; fi
  [ -n "$dir" ] || dir=$(default_dir "$TEAM")
  local key; key=$(key_of "$TEAM" "$proj")
  ensure_persona_settings
  check_persona_settings
  local failed=""
  if [ -n "$ROLE" ]; then
    start_role "$key" "$TEAM" "$ROLE" "$dir" "$explicit" || failed=1
  else
    for r in $(roles_of "$TEAM"); do start_role "$key" "$TEAM" "$r" "$dir" "$explicit" || failed=1; done
  fi
  # Recorded so cadre update can print the exact restart commands.
  local target=""
  if [ -n "$proj" ]; then
    if [ -n "$(reg has "$2")" ]; then target=$2; else target=$dir; fi
  fi
  tmux set-option -q -t "=cadre-$key:" @cadre_team "$TEAM" 2>/dev/null || true
  tmux set-option -q -t "=cadre-$key:" @cadre_project "$proj" 2>/dev/null || true
  tmux set-option -q -t "=cadre-$key:" @cadre_target "$target" 2>/dev/null || true
  if [ -n "$failed" ]; then exit 1; fi
}

cmd_down() {
  [ -n "${1:-}" ] || die "usage: cadre down <team|team/role> [project]"
  split_target "$1"
  local key; key=$(key_of "$TEAM" "${2:-}")
  if [ -z "$ROLE" ]; then
    if tmux kill-session -t "=cadre-$key" 2>/dev/null; then echo "  cadre-$key stopped"; else echo "  cadre-$key not running"; fi
  else
    if tmux kill-window -t "=cadre-$key:=$ROLE" 2>/dev/null; then echo "  $key-$ROLE stopped"; else echo "  $key-$ROLE not running"; fi
  fi
}

# Stops every running cadre session after a confirmation. Needs only tmux,
# so it runs without an active cadre.
cmd_down_all() {
  local yes="" a
  for a in "$@"; do
    case $a in --all) ;; --yes|-y) yes=1 ;; *) die "usage: cadre down --all [--yes]" ;; esac
  done
  [ -z "${CADRE_PERSONA:-}" ] || die "persona sessions cannot stop the whole cadre"
  local sessions; sessions=$(running_sessions)
  if [ -z "$sessions" ]; then echo "no cadre sessions running"; return 0; fi
  echo "Running cadre sessions:"
  show_sessions "$sessions"
  confirm "Stop these sessions?" "$yes" || exit 1
  local code=0
  # shellcheck disable=SC2046 # session names have no spaces
  stop_all down_all_done $(cut -f1 <<<"$sessions") || code=$?
  exit "$code"
}

down_all_done() { if [ -z "$STOP_FAILED" ]; then echo "stopped every cadre session"; fi; }

cmd_attach() {
  [ -n "${1:-}" ] || die "usage: cadre attach <team> [project]"
  local key; key=$(key_of "$1" "${2:-}")
  tmux has-session -t "=cadre-$key" 2>/dev/null || die "cadre-$key is not running"
  if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=cadre-$key"; else exec tmux attach -t "=cadre-$key"; fi
}

cmd_ls() {
  local sessions; sessions=$(tmux ls -F '#S' 2>/dev/null | grep '^cadre-' || true)
  for t in $(find "$PERSONAS" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort); do
    echo "$t"
    local keys; keys=$(grep -E "^cadre-$t(-|$)" <<<"$sessions" | sed 's/^cadre-//' || true)
    for r in $(roles_of "$t"); do
      local shown=""
      for k in $keys; do
        if window_exists "$k" "$r"; then echo "  [running] $k-$r"; shown=1; fi
      done
      [ -n "$shown" ] || echo "  [ ]       $t-$r"
    done
  done
}

cmd_projects() {
  reg table | while IFS=$'\t' read -r name team about; do
    local mark="  "; [ -d "$(project_dir "$name")" ] || mark="? "
    printf '%s%-14s %-8s %s\n' "$mark" "$name" "$team" "$about"
  done
}

cmd_sync() {
  local trust=1 cloned=()
  case "${1:-}" in --no-trust) trust="" ;; "") ;; *) die "usage: cadre sync [--no-trust]" ;; esac
  for name in $(reg names); do
    local path repo; path=$(project_dir "$name"); repo=$(reg "$name" repo)
    if [ -d "$path" ]; then echo "  $name: present"; continue; fi
    [ -n "$repo" ] || { echo "  $name: missing, and no repo to clone"; continue; }
    clone "$repo" "$path"
    echo "  $name: cloned to $path"
    cloned+=("$name")
  done
  if [ -n "$trust" ] && [ ${#cloned[@]} -gt 0 ]; then trust_report "${cloned[@]}"; fi
}

# Edits a JSON file that Claude Code also writes (~/.claude.json,
# ~/.claude/settings.json) without ever damaging it:
#   json_edit <op> <file> <backup> [args...]
# It never creates the file, leaves it untouched when it is not the JSON it
# expects or belongs to another user, copies it to <backup> before the first
# write (an existing backup, the oldest original, is kept), writes a
# temporary file with the same mode and renames it over the original, and
# starts again (up to 3 times) when the file changed while it worked.
# Exit: 0 written, 3 nothing to change, 4 no such file, 5 unreadable,
# unexpected content or another owner, 6 kept changing, 7 could not write.
# CADRE_TEST_JSON_EDIT_HOOK, for tests only, names a program run with the
# attempt number and the file just before the re-check.
# Op trust, args "name<TAB>path[<TAB>path...]": sets
# projects[path].hasTrustDialogAccepted for every path and prints
# "name<TAB>trusted" or "name<TAB>already" per project.
# Op unhook, arg the hook script of this framework: removes every
# SessionStart hook whose command is "bash <that script>" (compared by real
# path), then any group, SessionStart or hooks it left empty. It prints
# "removed<TAB>command" for those and "kept<TAB>command" for other
# orchestrator-hook.sh hooks (another framework's). Its backup is fresh on
# every write, unlike the other ops, which keep the first one.
# An op ending in :dry only reports: exit 0 when it would write, 3 when not.
json_edit() {
  python3 - "$@" <<'PY'
import hashlib, json, os, shlex, subprocess, sys, tempfile

op, path, backup, args = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]


class Shape(Exception):
    pass


def trust(data):
    if not isinstance(data, dict):
        raise Shape()
    projects = data.setdefault("projects", {})
    if not isinstance(projects, dict):
        raise Shape()
    lines = []
    for arg in args:
        name, *dirs = arg.split("\t")
        if all(isinstance(projects.get(d), dict) and projects[d].get("hasTrustDialogAccepted") is True for d in dirs):
            lines.append(name + "\talready")
            continue
        for d in dirs:
            entry = projects.setdefault(d, {})
            if not isinstance(entry, dict):
                raise Shape()
            entry["hasTrustDialogAccepted"] = True
        lines.append(name + "\ttrusted")
    return lines


def hook_script(hook):
    """The script a "bash <path>/orchestrator-hook.sh" hook runs, or None."""
    if not isinstance(hook, dict) or not isinstance(hook.get("command"), str):
        return None
    try:
        words = shlex.split(hook["command"])
    except ValueError:
        return None
    if len(words) == 2 and words[0] == "bash" and os.path.basename(words[1]) == "orchestrator-hook.sh":
        return words[1]
    return None


def is_ours(hook):
    script = hook_script(hook)
    return script is not None and os.path.realpath(script) == os.path.realpath(args[0])


def unhook(data):
    if not isinstance(data, dict):
        raise Shape()
    hooks = data.get("hooks")
    if hooks is None:
        return []
    if not isinstance(hooks, dict):
        raise Shape()
    groups = hooks.get("SessionStart")
    if groups is None:
        return []
    if not isinstance(groups, list):
        raise Shape()
    removed, kept, others = [], [], []
    for group in groups:
        if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
            raise Shape()
        mine = [h for h in group["hooks"] if is_ours(h)]
        removed += [h["command"] for h in mine]
        others += [h["command"] for h in group["hooks"] if hook_script(h) and not is_ours(h)]
        if not mine:
            kept.append(group)
        elif len(mine) < len(group["hooks"]):
            group["hooks"] = [h for h in group["hooks"] if not is_ours(h)]
            kept.append(group)
    report = ["removed\t" + c for c in removed] + ["kept\t" + c for c in others]
    if not removed:
        return report
    if kept:
        hooks["SessionStart"] = kept
    else:
        del hooks["SessionStart"]
    if not hooks:
        del data["hooks"]
    return report


OPS = {"trust": trust, "unhook": unhook}
dry = op.endswith(":dry")
op = op.split(":")[0]
path = os.path.realpath(path)


def snapshot():
    st = os.stat(path)
    with open(path, "rb") as f:
        raw = f.read()
    return (st.st_size, st.st_mtime_ns, hashlib.sha256(raw).hexdigest()), raw, st.st_mode & 0o7777


def write(target, data, mode):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".cadre-")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        return tmp
    except BaseException:
        os.unlink(tmp)
        raise


def attempt(n):
    try:
        stamp, raw, mode = snapshot()
        owner = os.stat(path).st_uid
    except FileNotFoundError:
        sys.exit(4)
    except OSError:
        sys.exit(5)
    try:
        data = json.loads(raw)
        before = json.dumps(data, sort_keys=True)
        lines = OPS[op](data)
        after = json.dumps(data, sort_keys=True)
        new = (json.dumps(data, indent=2) + "\n").encode()
    except (ValueError, TypeError, RecursionError, Shape):
        sys.exit(5)
    if after == before:
        print("\n".join(lines))
        sys.exit(3)
    if owner != os.geteuid():
        sys.exit(5)
    if dry:
        print("\n".join(lines))
        sys.exit(0)
    tmp = None
    try:
        if op == "unhook" or not os.path.lexists(backup):
            os.replace(write(backup, raw, mode), backup)
        tmp = write(path, new, mode)
        hook = os.environ.get("CADRE_TEST_JSON_EDIT_HOOK")
        if hook:
            subprocess.call([hook, str(n), path])
        try:
            same = snapshot()[0] == stamp
        except OSError:
            same = False
        if same:
            os.replace(tmp, path)
            tmp = None
            print("\n".join(lines))
            sys.exit(0)
    except OSError:
        sys.exit(7)
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


try:
    for n in range(1, 4):
        attempt(n)
    sys.exit(6)
except SystemExit:
    raise
except BaseException:
    sys.exit(5)
PY
}

# The persona settings file: a plain Claude Code settings file holding the
# user's grants to personas and fixed entries that keep personas from
# changing it. Only permissions.allow/deny and autoMode.allow/soft_deny are
# allowed, since a --settings file sits at command-line precedence and could
# otherwise carry hooks or env. Personas never get the file itself: each
# launch passes a copy rebuilt from the validated keys only (export), so a
# duplicate key, an edit between check and launch, or a live edit to the
# file cannot reach them.
#   persona_settings create <file>          write the starting file
#   persona_settings check <file>           exit 1 and say why when unusable
#   persona_settings export <file> <dir>    write the copy, print its path
#   persona_settings record <file> <hashes> remember the file's hash
#   persona_settings verify <file> <hashes> exit 0 same, 1 changed, 2 unknown
# The fixed entries name the file by a pattern, not its path, so they stay
# valid when the cadre is cloned to another machine. Edit rules also cover
# the Write tool; Claude Code ignores Write(path) rules.
persona_settings() {
  python3 - "$@" <<'PY'
import hashlib, json, os, sys, tempfile

FIXED_DENY = ["Edit(//**/.claude/persona-settings.json)", "Bash(cadre allow:*)"]
LEGACY = ["Write(//**/.claude/persona-settings.json)"]
FIXED_SOFT = ("Changing persona permissions (editing a cadre's .claude/persona-settings.json "
              "or running cadre allow) is only done by the user through the orchestrator")
ALLOWED = {"permissions": ("allow", "deny"), "autoMode": ("allow", "soft_deny")}
op, path = sys.argv[1], sys.argv[2]


class Duplicate(ValueError):
    pass


def no_duplicates(pairs):
    keys = [k for k, _ in pairs]
    for k in keys:
        if keys.count(k) > 1:
            raise Duplicate(k)
    return dict(pairs)


def atomic(target, text, mode=0o600):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target) or ".", prefix=".cadre-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, target)


def problem(data):
    if not isinstance(data, dict):
        return "it is not a JSON object"
    for key, value in data.items():
        if key not in ALLOWED:
            return "it has the key %s; only permissions and autoMode are allowed" % key
        if not isinstance(value, dict):
            return "%s is not an object" % key
        for sub, items in value.items():
            if sub not in ALLOWED[key]:
                return "it has %s.%s; only %s are allowed" % (key, sub, " and ".join(ALLOWED[key]))
            if not isinstance(items, list) or not all(isinstance(i, str) for i in items):
                return "%s.%s is not a list of strings" % (key, sub)
            if key == "autoMode" and "$defaults" not in items:
                return "autoMode.%s lacks \"$defaults\", which would replace the built-in rules" % sub
    deny = data.get("permissions", {}).get("deny", [])
    if not all(d in deny for d in FIXED_DENY):
        return "permissions.deny lacks the entries that protect the file"
    if FIXED_SOFT not in data.get("autoMode", {}).get("soft_deny", []):
        return "autoMode.soft_deny lacks the entry that protects the file"
    return None


def load():
    """The parsed file, or exits 1 with the reason it cannot be used."""
    try:
        with open(path) as f:
            data = json.load(f, object_pairs_hook=no_duplicates)
    except OSError:
        why = "it cannot be read"
    except Duplicate as e:
        why = "it has the key %s twice" % e
    except ValueError:
        why = "it is not valid JSON"
    else:
        why = problem(data)
    if why:
        print(why)
        sys.exit(1)
    return data


def digest():
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def hashes(hfile):
    found = {}
    try:
        for line in open(hfile):
            h, _, p = line.rstrip("\n").partition(" ")
            if p:
                found[p] = h
    except OSError:
        pass
    return found


if op == "create":
    data = {"permissions": {"allow": [], "deny": FIXED_DENY},
            "autoMode": {"allow": ["$defaults"], "soft_deny": ["$defaults", FIXED_SOFT]}}
    atomic(path, json.dumps(data, indent=2) + "\n", 0o644)
elif op == "check":
    load()
elif op == "export":
    data = load()
    copy = {}
    for key, subs in ALLOWED.items():
        for sub in subs:
            items = [i for i in data.get(key, {}).get(sub, []) if i not in LEGACY]
            if sub in data.get(key, {}):
                copy.setdefault(key, {})[sub] = items
    text = json.dumps(copy, indent=2) + "\n"
    out = os.path.join(sys.argv[3], "persona-settings.%s.json" % hashlib.sha256(text.encode()).hexdigest()[:16])
    # Written whole at every start, never trusted because it exists.
    os.makedirs(sys.argv[3], exist_ok=True)
    atomic(out, text, 0o400)
    print(out)
elif op == "record":
    hfile = sys.argv[3]
    found = hashes(hfile)
    found[os.path.realpath(path)] = digest()
    os.makedirs(os.path.dirname(hfile), exist_ok=True)
    atomic(hfile, "".join("%s %s\n" % (h, p) for p, h in sorted(found.items())))
elif op == "verify":
    want = hashes(sys.argv[3]).get(os.path.realpath(path))
    sys.exit(2 if want is None else 0 if want == digest() else 1)
PY
}

# Creates the persona settings file when the cadre has none, records its
# hash and commits it.
ensure_persona_settings() {
  [ ! -e "$PSET" ] || return 0
  mkdir -p "$(dirname "$PSET")"
  persona_settings create "$PSET"
  persona_settings record "$PSET" "$PSET_HASHES"
  commit_change "Add the persona settings file" "$PSET"
  echo "  created $PSET (grants for personas; change it with cadre allow)"
}

# Whether the persona settings file is exactly as cadre last committed it:
# equal to HEAD, and the last commit that touched it is one cadre makes.
pset_from_cadre() {
  local rel=".claude/persona-settings.json" subject
  git -C "$CADRE_HOME" rev-parse --git-dir >/dev/null 2>&1 || return 1
  git -C "$CADRE_HOME" diff --quiet HEAD -- "$rel" 2>/dev/null || return 1
  [ -z "$(git -C "$CADRE_HOME" status --porcelain -- "$rel")" ] || return 1
  subject=$(git -C "$CADRE_HOME" log -1 --format=%s -- "$rel" 2>/dev/null || true)
  case $subject in
    "Add the persona settings file"|"Allow for personas: "*|"Allow for personas once: "*|"Remove grant for personas: "*|"Remove one-time grants for personas") return 0 ;;
    *) return 1 ;;
  esac
}

# Checks the persona settings file and sets PSET_ARG to a validated copy for
# personas (empty when the file is unusable). Warns when the file is unusable
# or was changed outside cadre allow. A file with no recorded hash, or one
# that differs from it, is accepted quietly only when it is what cadre last
# committed (for example a grant pulled from another machine).
check_persona_settings() {
  local why code=0
  PSET_ARG=""
  ensure_build
  if ! PSET_ARG=$(persona_settings export "$PSET" "$BUILD"); then
    why=$PSET_ARG PSET_ARG=""
    echo "warning: personas start without $PSET because $why; fix it or restore it with git -C $CADRE_HOME checkout -- .claude/persona-settings.json" >&2
    return 0
  fi
  persona_settings verify "$PSET" "$PSET_HASHES" || code=$?
  [ "$code" != 0 ] || return 0
  if pset_from_cadre; then persona_settings record "$PSET" "$PSET_HASHES"; return 0; fi
  echo "warning: $PSET was changed outside cadre allow (see git -C $CADRE_HOME diff and log -p -- .claude/persona-settings.json); personas still get it because it is valid" >&2
}

# Claude Code's global config, where workspace trust is stored per folder.
claude_config() { echo "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"; }

# Why folder $1 (a physical path) must not be trusted, or nothing when it
# may be: only the top folder of a project repo is, never /, the home
# folder, the cadre or a folder containing it, or a team folder.
trust_refusal() {
  local d=$1 home cadre
  home=$(cd "$HOME" && pwd -P); cadre=$(cd "$CADRE_HOME" && pwd -P)
  if [ "$d" = / ]; then echo "it is the root folder"; return; fi
  if [ "$d" = "$home" ]; then echo "it is your home folder"; return; fi
  case "$cadre/" in "$d/"*) echo "it is the cadre folder or contains it"; return ;; esac
  case "$d/" in "$cadre/teams/"*) echo "it is a team folder"; return ;; esac
  [ "$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" = "$d" ] || echo "it is not the top folder of a git repo"
}

# Marks registry projects' folders as trusted in Claude Code, in one write
# with one backup. Each folder is keyed by its physical path and, when it
# differs, by the path as cadre spells it. Sets TRUST_RESULT to
# "name<TAB>trusted|already|refused|skipped[<TAB>reason]" lines and
# TRUST_NOTE to a note for the user when the config was left alone.
trust_projects() {
  local cfg args=() names=() name dir phys why code=0 out=""
  cfg=$(claude_config)
  TRUST_RESULT="" TRUST_NOTE=""
  if [ -n "${CADRE_PERSONA:-}" ]; then
    TRUST_NOTE="persona sessions cannot trust folders in Claude Code; run cadre trust $* from the orchestrator"
    for name in "$@"; do TRUST_RESULT+="$name"$'\t'"skipped"$'\n'; done
    return
  fi
  for name in "$@"; do
    dir=$(cd "$(project_dir "$name")" && pwd); phys=$(cd "$dir" && pwd -P)
    why=$(trust_refusal "$phys")
    if [ -n "$why" ]; then TRUST_RESULT+="$name"$'\t'"refused"$'\t'"$why"$'\n'; continue; fi
    names+=("$name")
    if [ "$dir" = "$phys" ]; then args+=("$name"$'\t'"$phys"); else args+=("$name"$'\t'"$phys"$'\t'"$dir"); fi
  done
  [ ${#names[@]} -gt 0 ] || return 0
  out=$(json_edit trust "$cfg" "$cfg.bak-cadre" "${args[@]}") || code=$?
  case $code in
    0|3) TRUST_RESULT+="$out"$'\n'; return ;;
    4) TRUST_NOTE="Claude Code has not created its config yet; it will ask to trust the folder on first launch" ;;
    6) TRUST_NOTE="warning: $cfg kept changing (a running Claude Code session?), so it was left unchanged; Claude Code will ask to trust the folder on first launch" ;;
    7) TRUST_NOTE="warning: could not write next to $cfg (folder not writable, or disk full?), so it was left unchanged; Claude Code will ask to trust the folder on first launch" ;;
    *) TRUST_NOTE="warning: $cfg is not a file cadre can safely edit (unreadable, not valid JSON, an unexpected shape, or owned by another user), so it was left unchanged; Claude Code will ask to trust the folder on first launch" ;;
  esac
  for name in "${names[@]}"; do TRUST_RESULT+="$name"$'\t'"skipped"$'\n'; done
}

trust_of() { awk -F'\t' -v n="$1" -v f="${2:-2}" '$1 == n { print $f }' <<<"$TRUST_RESULT"; }

# Trusts the given projects and prints one line per project.
trust_report() {
  local name
  trust_projects "$@"
  for name in "$@"; do
    case $(trust_of "$name") in
      trusted) echo "  $name: trusted in Claude Code" ;;
      already) echo "  $name: already trusted in Claude Code" ;;
      refused) echo "  $name: not trusted, $(trust_of "$name" 3)" ;;
      *) echo "  $name: not trusted (see below)" ;;
    esac
  done
  if [ -n "$TRUST_NOTE" ]; then echo "$TRUST_NOTE"; fi
}

cmd_trust() {
  local names=() name
  [ -z "${CADRE_PERSONA:-}" ] || die "persona sessions cannot trust folders in Claude Code; ask the user in the orchestrator"
  case "${1:-}" in
    --all)
      [ -z "${2:-}" ] || die "usage: cadre trust <project> | --all"
      for name in $(reg names); do
        if [ -d "$(project_dir "$name")" ]; then names+=("$name"); else echo "  $name: missing locally, skipped (run cadre sync)"; fi
      done ;;
    ""|-*) die "usage: cadre trust <project> | --all" ;;
    *)
      [ -n "$(reg has "$1")" ] || die "'$1' is not a registered project (only registry projects are trusted; see cadre projects)"
      [ -d "$(project_dir "$1")" ] || die "project '$1' is not at $(project_dir "$1") (run cadre sync)"
      names=("$1") ;;
  esac
  if [ ${#names[@]} -gt 0 ]; then trust_report "${names[@]}"; fi
}

# Clone owner/repo (through gh when signed in), a URL, or a local path.
clone() {
  mkdir -p "$(dirname "$2")"
  case $1 in
    */*/*|/*|.*|*:*) git clone -q "$1" "$2" ;;
    *) if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then gh repo clone "$1" "$2" -- -q
       else git clone -q "https://github.com/$1.git" "$2"; fi ;;
  esac
}

cmd_init() {
  local name=${1:-} parent=${2:-$PWD}
  [ -n "$name" ] || die "usage: cadre init <name> [parent dir]"
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "name may use letters, digits, - and _"
  parent=$(cd "$parent" && pwd)
  local dest="$parent/$name"
  [ -e "$dest" ] && die "$dest already exists"
  cp -R "$CADRE_ROOT/template" "$dest"
  mkdir -p "$dest/projects"
  find "$dest" -type f -name '*.md' -exec perl -pi -e "s/\{\{name\}\}/$name/g" {} +
  git -C "$dest" init -q -b main
  git -C "$dest" add -A
  if git -C "$dest" config user.email >/dev/null; then
    git -C "$dest" commit -qm "Start $name from the cadre template"
  else
    echo "note: git has no user identity, so $name was left uncommitted; set one (git config --global user.name/user.email) and commit"
  fi
  set_home "$dest"
  echo "created $dest and made it the active cadre"
}

cmd_use() {
  if [ -z "${1:-}" ] || [ ! -d "$1/personas" ]; then die "usage: cadre use <cadre dir> (a folder with personas/)"; fi
  set_home "$(cd "$1" && pwd)"
  echo "active cadre: $(cat "$CONFIG")"
}

version_in() { sed -n 's/^CADRE_VERSION=//p' "$1" | head -1; }

# Prints the CHANGELOG's Unreleased section when it has entries, then the
# sections newer than version $2; nothing when it has no sections it can read.
changes_since() {
  python3 - "$1" "$2" <<'PY'
import re, sys
path, old = sys.argv[1], sys.argv[2]
def ver(s):
    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s)
    return tuple(int(x) for x in m.groups()) if m else None
try:
    lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
except OSError:
    sys.exit(0)
old = ver(old)
sections, cur = [], None
for line in lines:
    if line.startswith("## "):
        cur = [line]
        sections.append(cur)
    elif cur is not None:
        cur.append(line)
out = []
for sec in sections:
    v = ver(sec[0][3:])
    if sec[0].strip() == "## Unreleased":
        keep = any(l.strip() for l in sec[1:])
    else:
        keep = v is not None and old is not None and v > old
    if keep:
        out.append("\n".join(sec).strip())
print("\n\n".join(out))
PY
}

# Whether the installed cadre command and skill links are missing or point
# into framework folder $1, so relinking cannot take them from another clone.
links_point_here() {
  local here l t
  here=$(cd "$1" && pwd -P)
  for l in "$HOME/.local/bin/cadre" "$HOME/.claude/skills/cadre"; do
    if [ ! -e "$l" ] && [ ! -L "$l" ]; then continue; fi
    [ -L "$l" ] || return 1
    t=$(resolve "$l")
    t=$(cd "$(dirname "$t")" 2>/dev/null && pwd -P) || return 1
    case "$t/" in "$here/"*) ;; *) return 1 ;; esac
  done
}

# Prints the commands that restart each persona in the running sessions.
# Sessions started before cadre recorded team and project get a template.
restart_commands() {
  local s team proj target role generic=""
  while IFS=$'\t' read -r s _; do
    team=$(tmux show-options -qv -t "=$s:" @cadre_team 2>/dev/null || true)
    if [ -z "$team" ]; then generic=1; continue; fi
    proj=$(tmux show-options -qv -t "=$s:" @cadre_project 2>/dev/null || true)
    target=$(tmux show-options -qv -t "=$s:" @cadre_target 2>/dev/null || true)
    for role in $(tmux list-windows -t "=$s" -F '#W' 2>/dev/null); do
      echo "  cadre down $team/$role${proj:+ $proj} && cadre up $team/$role${target:+ $(printf '%q' "$target")}"
    done
  done <<<"$1"
  if [ -n "$generic" ]; then
    echo "  cadre down <team> [project] && cadre up <team> [project]"
    echo "  (session cadre-<team>-<project> is team <team>, project <project>)"
  fi
}

# Updates the framework this command runs from. The whole update runs inside
# this function, which bash has parsed in full before the merge rewrites
# bin/cadre, and the caller exits right after it returns.
cmd_update() {
  local check=""
  case "${1:-}" in
    --check) check=1 ;;
    "") ;;
    *) die "usage: cadre update [--check]" ;;
  esac
  [ -n "$check" ] || [ -z "${CADRE_PERSONA:-}" ] || die "persona sessions cannot update cadre"
  local fw=$CADRE_ROOT top branch def ahead old new notes
  top=$(git -C "$fw" rev-parse --show-toplevel 2>/dev/null || true)
  [ "$top" = "$(cd "$fw" && pwd -P)" ] || die "$fw is not a git checkout; update it by hand"
  [ -z "$(git -C "$fw" status --porcelain --untracked-files=no)" ] \
    || die "$fw has local changes to tracked files; commit or stash them, then run cadre update again"
  def=$(git -C "$fw" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
  def=${def#origin/}; def=${def:-main}
  branch=$(git -C "$fw" symbolic-ref -q --short HEAD || true)
  [ -n "$branch" ] || die "$fw has a detached HEAD; switch to $def first (git -C $fw switch $def)"
  [ "$branch" = "$def" ] || die "$fw is on branch $branch, not $def; switch to $def first (git -C $fw switch $def)"
  GIT_TERMINAL_PROMPT=0 git -C "$fw" fetch -q origin || die "could not fetch from origin in $fw (offline, or no access?)"
  git -C "$fw" rev-parse -q --verify "origin/$def" >/dev/null || die "origin has no branch $def"

  old=$(version_in "$fw/bin/cadre")
  if [ "$(git -C "$fw" rev-parse HEAD)" = "$(git -C "$fw" rev-parse "origin/$def")" ]; then
    echo "cadre $old is up to date"; return 0
  fi
  ahead=$(git -C "$fw" rev-list --count "origin/$def..HEAD")
  [ "$ahead" = 0 ] || die "$fw has $ahead local commit(s) that origin/$def lacks; cadre update only fast-forwards, so move them to a branch first"
  new=$(git -C "$fw" show "origin/$def:bin/cadre" 2>/dev/null | sed -n 's/^CADRE_VERSION=//p' | head -1 || true)
  [ -n "$new" ] || die "origin/$def has no bin/cadre with a version (unknown); not updating $fw"
  if [ -n "$check" ]; then echo "update available: $old -> $new"; exit 3; fi

  git -C "$fw" merge -q --ff-only "origin/$def" || die "the fast-forward to origin/$def failed in $fw"
  new=$(version_in "$fw/bin/cadre")
  echo "updated cadre $old -> $new"
  notes=$(changes_since "$fw/CHANGELOG.md" "$old" || true)
  if [ -n "$notes" ]; then echo; echo "$notes"; echo
  elif [ -f "$fw/CHANGELOG.md" ]; then echo "see $fw/CHANGELOG.md for what changed"; fi
  if links_point_here "$fw"; then
    bash "$fw/install.sh" --link-only || echo "warning: relinking failed; run $fw/install.sh --link-only" >&2
  else
    echo "the installed cadre command or skill points at another framework folder; links left as they are (run $fw/install.sh --link-only to switch to this one)"
  fi

  local sessions; sessions=$(running_sessions)
  if [ -n "$sessions" ]; then
    echo "These sessions still run the old version until restarted:"
    show_sessions "$sessions"
    echo "Restart them with:"
    restart_commands "$sessions"
  fi
}

# The physical path of file or folder $1.
phys_of() {
  if [ -d "$1" ]; then (cd "$1" && pwd -P); else echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"; fi
}

# What uninstall does with link $1 that the installer points at $2: "remove"
# when it resolves there, "missing" when there is nothing, else the reason it
# is left in place.
link_plan() {
  local l=$1 want=$2 t
  if [ ! -e "$l" ] && [ ! -L "$l" ]; then echo missing; return; fi
  if [ ! -L "$l" ]; then echo "$l is not a link; left in place"; return; fi
  t=$(resolve "$l")
  if [ -e "$t" ] && [ "$(phys_of "$t")" = "$(phys_of "$want")" ]; then echo remove
  else echo "$l points to $t, not this framework; left in place"; fi
}

# The framework folder that link $1 (to <framework>/bin/cadre or
# <framework>/skills/cadre) belongs to,
# when it resolves to an existing framework other than this one.
other_framework() {
  local l=$1 t
  [ -L "$l" ] || return 0
  t=$(resolve "$l"); [ -e "$t" ] || return 0
  t=$(phys_of "$(dirname "$t")/..")
  [ -f "$t/bin/orchestrator-hook.sh" ] || return 0
  [ "$t" = "$(phys_of "$CADRE_ROOT")" ] || echo "$t"
}

# Why uninstall must not delete folder $1, or nothing when it may: never the
# home folder, or a folder that is or holds the cadre or the framework.
unsafe_to_remove() {
  local d f
  [ -e "$1" ] || return 0
  d=$(phys_of "$1")
  if [ "$d" = "$(phys_of "$HOME")" ]; then echo "it is your home folder"; return; fi
  for f in "$UN_HOME" "$CADRE_ROOT"; do
    if [ -n "$f" ] && [ -e "$f" ]; then
      case "$(phys_of "$f")/" in "$d/"*) echo "it is or holds $f"; return ;; esac
    fi
  done
}

# What uninstall keeps: the cadre, its projects, the framework, backups and
# trust entries.
uninstall_keeps() {
  local name dir inside="" outside=""
  if [ -n "$UN_HOME" ]; then
    if [ -d "$UN_HOME" ]; then echo "  your cadre: $UN_HOME"; else echo "  your cadre: $UN_HOME (not found)"; fi
  fi
  if [ -f "$UN_HOME/projects.yaml" ]; then
    for name in $(CADRE_HOME=$UN_HOME REGISTRY="$UN_HOME/projects.yaml" reg names); do
      dir=$(CADRE_HOME=$UN_HOME REGISTRY="$UN_HOME/projects.yaml" project_dir "$name")
      [ -d "$dir" ] || continue
      case "$dir/" in "$UN_HOME/"*) inside+="    $dir"$'\n' ;; *) outside+="    $dir"$'\n' ;; esac
    done
  fi
  if [ -n "$inside" ]; then echo "  projects in the cadre folder:"; printf '%s' "$inside"; fi
  if [ -n "$outside" ]; then echo "  projects outside the cadre folder:"; printf '%s' "$outside"; fi
  echo "  the framework: $CADRE_ROOT"
  for f in "$UN_SETTINGS.bak-cadre" "$UN_SETTINGS.bak-cadre-uninstall" "$(claude_config).bak-cadre"; do
    if [ -e "$f" ]; then echo "  backup: $f"; fi
  done
  echo "  Claude Code trust entries in $(claude_config)"
}

plan_link() {
  case $1 in
    remove) echo "  remove the link to $3: $2" ;;
    missing) echo "  $2: nothing to do (not there)" ;;
    *) echo "  $1" ;;
  esac
}

plan_folder() {
  if [ -n "$2" ]; then echo "  $1: left in place, $2"
  elif [ -d "$1" ]; then echo "  remove $1 ($3)"
  else echo "  $1: nothing to do (not there)"; fi
}

uninstall_plan() {
  echo "cadre uninstall plan:"
  if [ -n "$UN_SESSIONS" ]; then
    echo "  stop the running cadre sessions:"
    show_sessions "$UN_SESSIONS" | sed 's/^/  /'
  else echo "  cadre sessions: nothing to do (none running)"; fi
  plan_link "$UN_BIN" "$UN_BIN_LINK" "the cadre command"
  plan_link "$UN_SKILL" "$UN_SKILL_LINK" "the orchestrator skill"
  if [ -n "$UN_HOOK_WARN" ]; then echo "  $UN_HOOK_WARN"
  elif [ -n "$UN_HOOKS" ]; then
    echo "  remove the orchestrator hook from $UN_SETTINGS:"
    printf '%s\n' "$UN_HOOKS" | sed 's/^/    /'
  else echo "  orchestrator hook: nothing to do"; fi
  if [ -n "$UN_HOOKS_KEPT" ]; then
    echo "  orchestrator hooks of another framework, left in place:"
    printf '%s\n' "$UN_HOOKS_KEPT" | sed 's/^/    /'
  fi
  plan_folder "$UN_CONFIG" "$UN_CONFIG_WHY" "the active-cadre pointer and cadre's records"
  plan_folder "$UN_CACHE" "$UN_CACHE_WHY" "generated persona prompts"
  echo "Kept:"
  uninstall_keeps
}

# Removes a link or a cadre-owned folder and says so. It runs under
# uninstall_rest, where set -e is off, so it reports failure itself.
uninstall_rm() {
  if rm -rf "$1" 2>/dev/null && [ ! -e "$1" ] && [ ! -L "$1" ]; then echo "  removed $1"; return 0; fi
  echo "warning: could not remove $1; remove it by hand" >&2
  return 1
}

# The steps after the sessions stop, then the closing message. stop_all
# calls it from an || list, which turns set -e off here, so every step checks
# its own result and a failure returns 2.
uninstall_rest() {
  local rc=0 code=0
  if [ -n "$UN_HOOKS" ]; then
    json_edit unhook "$UN_SETTINGS" "$UN_SETTINGS.bak-cadre-uninstall" "$CADRE_ROOT/bin/orchestrator-hook.sh" >/dev/null || code=$?
    case $code in
      0) echo "  removed the orchestrator hook from $UN_SETTINGS (backup: $UN_SETTINGS.bak-cadre-uninstall)" ;;
      3|4) echo "  the orchestrator hook was already gone" ;;
      *) echo "warning: could not edit $UN_SETTINGS safely; left it unchanged (remove the orchestrator-hook.sh entry by hand)" >&2; rc=2 ;;
    esac
  fi
  if [ "$UN_BIN" = remove ]; then uninstall_rm "$UN_BIN_LINK" || rc=2; fi
  if [ "$UN_SKILL" = remove ]; then uninstall_rm "$UN_SKILL_LINK" || rc=2; fi
  if [ -d "$UN_CONFIG" ] && [ -z "$UN_CONFIG_WHY" ]; then uninstall_rm "$UN_CONFIG" || rc=2; fi
  if [ -d "$UN_CACHE" ] && [ -z "$UN_CACHE_WHY" ]; then uninstall_rm "$UN_CACHE" || rc=2; fi
  echo
  echo "cadre is uninstalled. Kept, to delete by hand if you no longer want them:"
  uninstall_keeps
  echo "The trust entries stay because Claude Code shares them with your own sessions. To revoke one, remove"
  echo "projects[\"<path>\"].hasTrustDialogAccepted from $(claude_config) by hand."
  echo "To reinstall: $CADRE_ROOT/install.sh --link-only, then cadre use <your cadre folder> (or run the installer)."
  return "$rc"
}

# Undoes what the installer wired into this machine; never deletes a file
# the user owns. Runs before load_home, so a broken or missing cadre is fine.
cmd_uninstall() {
  local yes="" dry="" force="" a code=0 other out
  for a in "$@"; do
    case $a in
      --yes|-y) yes=1 ;;
      --dry-run) dry=1 ;;
      --force) force=1 ;;
      *) die "usage: cadre uninstall [--yes | --dry-run] [--force]" ;;
    esac
  done
  [ -z "${CADRE_PERSONA:-}" ] || die "persona sessions cannot uninstall cadre"

  UN_HOME="" UN_SETTINGS="$HOME/.claude/settings.json" UN_CONFIG="$HOME/.config/cadre"
  UN_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cadre"
  UN_BIN_LINK="$HOME/.local/bin/cadre" UN_SKILL_LINK="$HOME/.claude/skills/cadre"
  if [ -n "${CADRE_HOME:-}" ]; then UN_HOME=$CADRE_HOME
  elif [ -f "$CONFIG" ]; then UN_HOME=$(expand "$(head -1 "$CONFIG")"); fi
  for a in "$UN_BIN_LINK" "$UN_SKILL_LINK"; do
    other=$(other_framework "$a")
    if [ -n "$other" ] && [ -z "$force" ]; then
      die "cadre is installed from $other; run $other/bin/cadre uninstall. (--force goes ahead from here: it leaves that framework's links and hook, but still stops every cadre session and removes ~/.config/cadre and the cache, which $other uses.)"
    fi
  done
  UN_SESSIONS=$(running_sessions)
  UN_CONFIG_WHY=$(unsafe_to_remove "$UN_CONFIG") UN_CACHE_WHY=$(unsafe_to_remove "$UN_CACHE")
  UN_BIN=$(link_plan "$UN_BIN_LINK" "$CADRE_ROOT/bin/cadre")
  UN_SKILL=$(link_plan "$UN_SKILL_LINK" "$CADRE_ROOT/skills/cadre")
  UN_HOOKS="" UN_HOOKS_KEPT="" UN_HOOK_WARN=""
  out=$(json_edit unhook:dry "$UN_SETTINGS" "$UN_SETTINGS.bak-cadre-uninstall" "$CADRE_ROOT/bin/orchestrator-hook.sh") || code=$?
  case $code in
    0|3)
      UN_HOOKS=$(awk -F'\t' '$1 == "removed" { print $2 }' <<<"$out")
      UN_HOOKS_KEPT=$(awk -F'\t' '$1 == "kept" { print $2 }' <<<"$out") ;;
    4) ;;
    *) UN_HOOK_WARN="warning: $UN_SETTINGS is not a file cadre can safely edit (unreadable, not valid JSON, an unexpected shape, or owned by another user); left untouched, so remove any orchestrator-hook.sh entry by hand" ;;
  esac

  if [ -z "$UN_SESSIONS$UN_HOOKS" ] && [ "$UN_BIN" != remove ] && [ "$UN_SKILL" != remove ] \
    && { [ ! -d "$UN_CONFIG" ] || [ -n "$UN_CONFIG_WHY" ]; } && { [ ! -d "$UN_CACHE" ] || [ -n "$UN_CACHE_WHY" ]; }; then
    for a in "$UN_BIN" "$UN_SKILL"; do [ "$a" = missing ] || echo "$a"; done
    if [ -n "$UN_CONFIG_WHY" ]; then echo "$UN_CONFIG: left in place, $UN_CONFIG_WHY"; fi
    if [ -n "$UN_CACHE_WHY" ]; then echo "$UN_CACHE: left in place, $UN_CACHE_WHY"; fi
    if [ -n "$UN_HOOK_WARN" ]; then echo "$UN_HOOK_WARN" >&2; fi
    echo "cadre is not installed here; nothing to do"
    if [ -n "$UN_HOOK_WARN" ]; then exit 2; fi
    exit 0
  fi
  uninstall_plan
  if [ -n "$dry" ]; then exit 0; fi
  confirm "Uninstall cadre?" "$yes" || exit 1
  if [ -n "$UN_HOOK_WARN" ]; then echo "$UN_HOOK_WARN" >&2; fi
  code=0
  # shellcheck disable=SC2046 # session names have no spaces
  stop_all uninstall_rest $(cut -f1 <<<"$UN_SESSIONS") || code=$?
  if [ "$code" = 0 ] && [ -n "$UN_HOOK_WARN" ]; then code=2; fi
  return "$code"
}

# Records a change to the cadre in its own git history, when it has one.
commit_change() {
  local msg=$1; shift
  git -C "$CADRE_HOME" rev-parse --git-dir >/dev/null 2>&1 || return 0
  if ! git -C "$CADRE_HOME" config user.email >/dev/null; then
    echo "note: git has no user identity, so this change was left uncommitted in $CADRE_HOME; set one (git config --global user.name/user.email) and commit"
    return 0
  fi
  if git -C "$CADRE_HOME" add -- "$@"; then git -C "$CADRE_HOME" commit -qm "$msg" -- "$@" || true; fi
}

cmd_add() {
  case "${1:-}" in
    project)
      shift
      local trust=1 a pos=()
      for a in "$@"; do
        case $a in
          --no-trust) trust="" ;;
          -*) die "unknown option $a (usage: cadre add project <name> <owner/repo> [team] [about] [--no-trust])" ;;
          *) pos+=("$a") ;;
        esac
      done
      local name=${pos[0]:-} repo=${pos[1]:-} team=${pos[2]:-dev} about=${pos[3]:-}
      if [ -z "$name" ] || [ -z "$repo" ]; then die "usage: cadre add project <name> <owner/repo> [team] [about] [--no-trust]"; fi
      if ! [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || [[ $name == *..* ]]; then die "project name may use letters, digits, ., - and _ (no ..)"; fi
      [ -z "$(reg has "$name")" ] || die "project '$name' is already in projects.yaml"
      printf '\n%s:\n  repo: %s\n  team: %s\n  about: %s\n' "$name" "$repo" "$team" "$about" >> "$REGISTRY"
      commit_change "Add project $name" "$REGISTRY"
      local path where; path=$(project_dir "$name")
      if [ -d "$path" ]; then where="already at $path"; else clone "$repo" "$path"; where="cloned to $path"; fi
      if [ -z "$trust" ]; then echo "  $name added, $where"; return; fi
      trust_projects "$name"
      case $(trust_of "$name") in
        trusted) echo "  $name added, $where and trusted in Claude Code (registered projects are trusted; use --no-trust to skip)" ;;
        already) echo "  $name added, $where; its folder was already trusted in Claude Code" ;;
        refused) echo "  $name added, $where; not trusted in Claude Code, $(trust_of "$name" 3)" ;;
        *) echo "  $name added, $where"; echo "${TRUST_NOTE/the folder/$path}" ;;
      esac ;;
    team)
      [ -n "${2:-}" ] || die "usage: cadre add team <team>"
      mkdir -p "$PERSONAS/$2"; echo "  team $2 added; add personas with cadre add persona $2/<role>" ;;
    persona)
      [[ ${2:-} == */* ]] || die "usage: cadre add persona <team>/<role>"
      local f="$PERSONAS/$2.md"
      [ -e "$f" ] && die "$f already exists"
      mkdir -p "$(dirname "$f")"
      printf '# Persona: %s (%s team)\n\nYou are the %s. Describe what you own, how you work, and what your reply to the orchestrator contains.\n' "${2#*/}" "${2%%/*}" "${2#*/}" > "$f"
      commit_change "Add persona $2" "$f"
      echo "  created $f; edit it to describe the role" ;;
    *) die "usage: cadre add project|team|persona ..." ;;
  esac
}

case "${1:-}" in
  init)     shift; cmd_init "$@"; exit ;;
  use)      shift; cmd_use "$@"; exit ;;
  update)   shift; cmd_update "$@"; exit ;;
  down)     case " $* " in *" --all "*) shift; cmd_down_all "$@"; exit ;; esac ;;
  uninstall) shift; cmd_uninstall "$@"; exit ;;
  ""|-h|--help|help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit ;;
  version|--version|-v) echo "cadre $CADRE_VERSION"; exit ;;
esac
load_home

case "$1" in
  add)      shift; cmd_add "$@" ;;
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  attach)   shift; cmd_attach "$@" ;;
  ls)       cmd_ls ;;
  projects) cmd_projects ;;
  path)     [ -n "${2:-}" ] || die "usage: cadre path <project>"; read -r _ p <<<"$(locate "$2")"; echo "$p" ;;
  sync)     shift; cmd_sync "$@" ;;
  trust)    shift; cmd_trust "$@" ;;
  *)        die "unknown command '$1' (see cadre help)" ;;
esac
