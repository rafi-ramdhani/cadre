.DS_Store
# teams/ is tracked, so the work personas keep there is backed up with the
# cadre. Generated and bulky files are not.
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.next/
.cache/
dist/
target/
coverage/
*.log
# What cadre generates for each start: prompts, settings copies, locks.
/.claude/build/
# Environment files hold secrets; their templates are meant to be shared.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
